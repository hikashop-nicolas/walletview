{
  "name": "walletview",
  "version": "0.1.0",
  "description": "Standalone client-side viewer for wallet passes: Apple Wallet .pkpass and .pkpasses today, more pass and card formats later. Read-only, byte-in, no framework.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "vite build",
    "typecheck": "tsc -p tsconfig.check.json",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "bwip-js": "^4.0.0",
    "fflate": "^0.8.3"
  }
}
